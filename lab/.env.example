# PySOAR lab environment — copy to lab/.env and adjust as needed

# Set to 1 to use in-process MISP/pfSense mocks (fastest; no external services)
PYSOAR_MOCK_INTEGRATIONS=1

# Master key for encrypted API key vault (generate with: python pysoar.py --init-secrets)
PYSOAR_MASTER_KEY=

# pfSense mock HTTP service (when PYSOAR_MOCK_INTEGRATIONS=0)
PFSENSE_MOCK_URL=http://pfsense-mock:8080
PFSENSE_API_KEY=lab-test-key

# MISP (optional full profile — see docker-compose.yml)
MISP_URL=https://misp.local
MISP_API_KEY=

# Set to 1 when no analyzer vendor API keys are configured
PYSOAR_MOCK_ANALYZERS=1
